# Copy to .env (repo root). Defaults below match docker-compose.yml for local development.

# --- App ---
ENVIRONMENT=dev                       # dev | test | prod
LOG_LEVEL=INFO

# --- Postgres (Neon in prod; Compose in dev) ---
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ursache        # Neon/Postgres owner role: runs Alembic and roles.sql
APP_DATABASE_URL=postgresql+psycopg://ursache_app:ursache_app@localhost:5432/ursache        # Neon/Postgres: API read/write role
AGENT_DATABASE_URL=postgresql+psycopg://ursache_agent:ursache_agent@localhost:5432/ursache  # Neon/Postgres: read-only agent role
EVAL_DATABASE_URL=postgresql+psycopg://ursache_eval:ursache_eval@localhost:5432/ursache     # Neon/Postgres: evaluation reader role

# --- Qdrant (Qdrant Cloud in prod; Compose in dev) ---
QDRANT_URL=http://localhost:6333      # Qdrant: cluster URL
QDRANT_API_KEY=                       # Qdrant Cloud: API key (empty for local)
QDRANT_CLOUD_INFERENCE=false          # Qdrant: true = server-side BM25 (Cloud Inference), false = local fastembed
QDRANT_DOC_CHUNKS_COLLECTION=doc_chunks__gemb2_768__v1             # Qdrant: versioned text collection
QDRANT_DOC_CHUNKS_ALIAS=doc_chunks                                 # Qdrant: stable alias used by queries
QDRANT_DEFECT_IMAGES_COLLECTION=defect_images__gemb2_dinov2__v1    # Qdrant: versioned image collection
QDRANT_DEFECT_IMAGES_ALIAS=defect_images                           # Qdrant: stable alias used by queries
BM25_LOCAL_MODEL=Qdrant/bm25          # fastembed: local BM25 model name
BM25_CLOUD_MODEL=qdrant/bm25          # Qdrant Cloud Inference: BM25 model name

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=                       # Google AI Studio: API key
GEMINI_REASONING_MODEL=gemini-3.8-flash          # Gemini: Flash, used for reasoning steps
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite         # Gemini: Flash-Lite, used for light tasks
GEMINI_EMBEDDING_MODEL=gemini-embedding-2        # Gemini: multimodal embeddings
EMBEDDING_DIM=768                     # Gemini: output_dimensionality for embeddings
DINO_DIM=768                          # DINOv2 ViT-B/14 image vectors (computed offline)

# --- Cohere ---
COHERE_API_KEY=                       # Cohere: API key (trial key is free)
COHERE_RERANK_MODEL=rerank-v4.0-fast  # Cohere: multilingual reranker

# --- Blob storage (Backblaze B2 S3 API in prod) ---
BLOB_BACKEND=local                    # s3 | local
BLOB_LOCAL_ROOT=../data/blobs         # local: directory, relative to backend/
S3_ENDPOINT_URL=                      # Backblaze B2: S3 endpoint, e.g. https://s3.eu-central-003.backblazeb2.com
S3_BUCKET=                            # Backblaze B2: bucket name
S3_KEY_ID=                            # Backblaze B2: application key ID
S3_SECRET=                            # Backblaze B2: application key
S3_PUBLIC_BASE_URL=                   # Backblaze B2: public URL prefix for objects (optional)

# --- Simulator ---
GENERATED_DOCS_DIR=../data/generated/docs   # simulator: Markdown output for controlled documents, relative to backend/

# --- Tracing (Langfuse Cloud via OTLP; disabled when keys are empty) ---
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces  # Langfuse: EU; US is https://us.cloud.langfuse.com/...
LANGFUSE_PUBLIC_KEY=                  # Langfuse: public key (pk-lf-...)
LANGFUSE_SECRET_KEY=                  # Langfuse: secret key (sk-lf-...)
OTEL_SERVICE_NAME=ursache-api         # OpenTelemetry: service name on spans

# --- Quotas and rate limits (API-side guards) ---
QUOTA_TIMEZONE=America/Los_Angeles    # Gemini: daily quotas reset at midnight Pacific
QUOTA_REASONING_DAILY_REQUESTS=20     # Gemini Flash: daily request cap
QUOTA_LIGHT_DAILY_REQUESTS=500        # Gemini Flash-Lite: daily request cap
QUOTA_EMBEDDING_DAILY_REQUESTS=1000   # Gemini embeddings: daily request cap
QUOTA_RERANK_DAILY_REQUESTS=30        # Cohere rerank: daily request cap
LIVE_RUNS_PER_IP_PER_DAY=3            # API: live investigations per client IP per day
RATE_LIMIT_DEFAULT=60/minute          # API (slowapi): default per-IP limit

# --- CORS / frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000   # API: comma-separated allowed origins (add the Vercel URL in prod)
NEXT_PUBLIC_API_URL=http://localhost:8000    # Vercel/Next.js: backend base URL (set in Vercel project settings)
